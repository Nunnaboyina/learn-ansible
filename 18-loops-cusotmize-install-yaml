- name: install and remove packages
  hosts: local
  connection: local
  become: yes
  vars:
    packages:
    - { name: 'nginx', state: 'absent'}
    - { name: 'mysql', state: 'present'}
    - { name: 'git', state: 'absent'}
  tasks:
  - name: 
    package:
      name: "{{ item.name }}"
      state: "{{ item.state }}"
    loop: "{{packages}}"